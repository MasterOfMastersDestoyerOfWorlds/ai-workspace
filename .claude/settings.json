      "Bash(git tag*)",
      "Bash(git -* tag*)",
      "Bash(git update-index*)",
      "Bash(git -* update-index*)",
      "Bash(git update-ref*)",
      "Bash(git -* update-ref*)",
      "Bash(git worktree*)",
      "Bash(git -* worktree*)"
