      "Bash(git -* checkout*)",
      "Bash(git cherry-pick*)",
      "Bash(git -* cherry-pick*)",
      "Bash(git clean*)",
      "Bash(git -* clean*)",
      "Bash(git clone*)",
      "Bash(git -* clone*)",
      "Bash(git commit*)",
      "Bash(git -* commit*)",
      "Bash(git config*)",
      "Bash(git -* config*)",
      "Bash(git fetch*)",
      "Bash(git -* fetch*)",
      "Bash(git filter-branch*)",
      "Bash(git -* filter-branch*)",
      "Bash(git gc*)",
      "Bash(git -* gc*)",
      "Bash(git init*)",
      "Bash(git -* init*)",
      "Bash(git merge*)",
      "Bash(git -* merge*)",
      "Bash(git mv*)",
